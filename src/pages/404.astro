---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { withBase, absoluteUrl } from '../lib/url';
---

<Base
  title="Page not found"
  description={`This page does not exist on ${site.name} — the link may be outdated, or try the tools list from the homepage instead.`}
  noindex
  canonical={absoluteUrl('/')}
>
  <section class="container container--narrow section">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="muted">The link may be outdated or mistyped.</p>
    <p><a class="btn" href={withBase('/')}>Go to {site.name}</a></p>
  </section>
</Base>
